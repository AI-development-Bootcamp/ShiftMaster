{
  "name": "abra-shift-master",
  "version": "1.0.0",
  "private": true,
  "description": "Shift management application for Abra Bootcamp",
  "workspaces": [
    "client",
    "admin",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin",
    "dev:server": "npm run dev -w server",
    "dev:shared": "echo 'Shared workspace has no dev script'",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w admin && npm run build -w server",
    "build:shared": "npm run build -w shared",
    "build:client": "npm run build -w client",
    "build:admin": "npm run build -w admin",
    "build:server": "npm run build -w server",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test -w shared",
    "test:client": "npm run test -w client",
    "test:admin": "npm run test -w admin",
    "test:server": "npm run test -w server",
    "test:ui": "npm run test:ui --workspaces --if-present",
    "test:ui:shared": "npm run test:ui -w shared",
    "test:ui:client": "npm run test:ui -w client",
    "test:ui:admin": "npm run test:ui -w admin",
    "test:ui:server": "npm run test:ui -w server",
    "type-check": "npm run type-check --workspaces --if-present",
    "type-check:shared": "npm run type-check -w shared",
    "type-check:client": "npm run type-check -w client",
    "type-check:admin": "npm run type-check -w admin",
    "type-check:server": "npm run type-check -w server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:shared": "npm run lint -w shared || echo 'Shared workspace has no lint script'",
    "lint:client": "npm run lint -w client",
    "lint:admin": "npm run lint -w admin",
    "lint:server": "npm run lint -w server",
    "lint:fix": "npm run lint:fix --workspaces --if-present || npm run lint --workspaces --if-present -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install",
    "start": "npm run start -w server",
    "start:server": "npm run start -w server",
    "preview:client": "npm run preview -w client",
    "preview:admin": "npm run preview -w admin"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
