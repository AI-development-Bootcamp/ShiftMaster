{
  "name": "abra-shift-master",
  "version": "1.0.0",
  "private": true,
  "description": "Shift management application for Abra Bootcamp",
  "workspaces": [
    "client",
    "admin",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w admin && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:admin": "npm run build -w admin",
    "build:server": "npm run build -w server",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test -w client",
    "test:admin": "npm run test -w admin",
    "test:server": "npm run test -w server",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
